        local sStroke = Instance.new("UIStroke")
        sStroke.Color     = Color3.fromRGB(50, 50, 50)
        sStroke.Thickness = 1
        sStroke.Parent    = swatch

        -- Hex label
        local function colorToHex(c)
            return string.format("%02X%02X%02X",
                math.round(c.R * 255),
                math.round(c.G * 255),
                math.round(c.B * 255))
        end

        local hexBox = Instance.new("TextBox")
        hexBox.Size             = UDim2.fromOffset(52, 18)
        hexBox.BackgroundColor3 = Color3.fromRGB(13, 13, 13)
        hexBox.BorderSizePixel  = 0
        hexBox.Text             = colorToHex(currentColor)
        hexBox.TextColor3       = Theme.TextColor
        hexBox.PlaceholderText  = "RRGGBB"
        hexBox.TextSize         = 11
        hexBox.Font             = Enum.Font.Code
        hexBox.ClearTextOnFocus = false
        hexBox.LayoutOrder      = 1
        hexBox.Parent           = right

        local hCorner = Instance.new("UICorner")
        hCorner.CornerRadius = UDim.new(0, 3)
        hCorner.Parent       = hexBox

        local hStroke = Instance.new("UIStroke")
        hStroke.Color     = Color3.fromRGB(34, 34, 34)
        hStroke.Thickness = 1
        hStroke.Parent    = hexBox

        track(hexBox.FocusLost:Connect(function()
            local hex = hexBox.Text:gsub("#", ""):upper()
            if #hex == 6 then
                local r = tonumber(hex:sub(1,2), 16)
                local g = tonumber(hex:sub(3,4), 16)
                local b = tonumber(hex:sub(5,6), 16)
                if r and g and b then
                    currentColor = Color3.fromRGB(r, g, b)
                    swatch.BackgroundColor3 = currentColor
                    for _, cb in ipairs(changedCallbacks) do pcall(cb, currentColor) end
                end
            end
            hexBox.Text = colorToHex(currentColor)
        end))

        local ctrl = { Value = currentColor }
        function ctrl:Set(c)
            currentColor = c
            swatch.BackgroundColor3 = c
            hexBox.Text = colorToHex(c)
        end
        function ctrl:Get() return currentColor end
        function ctrl:OnChanged(cb) table.insert(changedCallbacks, cb) return self end
        return ctrl
    end

    -- GROUP (indented child section)
    function Section:AddGroup(o)
        elementCount += 1
        local source = o.Source  -- toggle ctrl yang mengontrol visibility group

        local groupFrame = Instance.new("Frame")
        groupFrame.Name             = "Group"
        groupFrame.Size             = UDim2.new(1, 0, 0, 0)
        groupFrame.AutomaticSize    = Enum.AutomaticSize.Y
        groupFrame.BackgroundTransparency = 1
        groupFrame.LayoutOrder      = elementCount

        -- Garis aksen kiri
        local accentLine = Instance.new("Frame")
        accentLine.Size             = UDim2.new(0, 2, 1, 0)
        accentLine.Position         = UDim2.fromOffset(PAD - 2, 0)
        accentLine.BackgroundColor3 = Theme.Accent
        accentLine.BackgroundTransparency = 0.6
        accentLine.BorderSizePixel  = 0
        accentLine.Parent           = groupFrame

        local inner = Instance.new("Frame")
        inner.Name             = "Inner"
        inner.Position         = UDim2.fromOffset(PAD + 4, 0)
        inner.Size             = UDim2.new(1, -(PAD + 4), 0, 0)
        inner.AutomaticSize    = Enum.AutomaticSize.Y
        inner.BackgroundTransparency = 1
        inner.Parent           = groupFrame

        local innerLayout = Instance.new("UIListLayout")
        innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        innerLayout.Parent    = inner

        groupFrame.Parent = sectionFrame

        -- Jika ada source toggle, ikat visibility
        if source then
            groupFrame.Visible = source:Get()
            source:OnChanged(function(v)
                groupFrame.Visible = v
            end)
        end

        -- Group mengekspos API Section yang sama tapi parent-nya inner
        local GroupSection = {}
        setmetatable(GroupSection, {__index = function(_, k)
            -- bungkus function agar parent-nya inner
            if Section[k] then
                return function(_, ...)
                    local old = sectionFrame
                    sectionFrame = inner
                    local count_old = elementCount
                    local r = Section[k](self, ...)
                    elementCount = count_old
                    sectionFrame = old
                    return r
                end
            end
        end})
        -- rebuild sederhana langsung tanpa meta magic
        local GS = {}
        local gc = 0
        function GS:AddToggle(o2)
            gc += 1
            local s2 = { AddToggle=Section.AddToggle, AddSlider=Section.AddSlider,
                         AddDropdown=Section.AddDropdown, AddButton=Section.AddButton,
                         AddLabel=Section.AddLabel, AddDivider=Section.AddDivider,
                         AddKeybind=Section.AddKeybind, AddColor=Section.AddColor }
            -- simple pass-through ke inner frame
            local tmp = sectionFrame
            local tcount = elementCount
            sectionFrame = inner; elementCount = gc
            local r = Section.AddToggle(self, o2)
            sectionFrame = tmp; elementCount = tcount
            return r
        end
        -- delegate semua elemen ke inner
        local function delegate(fname)
            GS[fname] = function(self2, o2)
                gc += 1
                local tmp = sectionFrame
                local tcount = elementCount
                sectionFrame = inner; elementCount = gc
                local r = Section[fname](self, o2)
                sectionFrame = tmp; elementCount = tcount
                return r
            end
        end
        for _, fname in ipairs({"AddSlider","AddDropdown","AddButton","AddLabel","AddDivider","AddKeybind","AddColor"}) do
            delegate(fname)
        end

        return GS
    end

    return Section
end

--==========================================================================
--  PUBLIC API  –  Window:AddTab(...)
--==========================================================================

local Window = {}

local TabPages     = {}  -- { railBtn, setActive, page }
local ActivePage   = nil
local SubTabs      = {}
local ActiveSubTab = nil
local railOrder    = 1

function Window:AddTab(opts)
    local label = opts.Label or "Tab"
    local icon  = opts.Icon  or nil  -- opsional, gunakan 1 karakter

    local railBtn, railSetActive = makeRailTab(label, icon, railOrder)
    railOrder += 1

    -- Page frame
    local page = Instance.new("Frame")
    page.Name             = "Page_" .. label
    page.Size             = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible          = false
    page.Parent           = Grid

    -- Sub-tab entries untuk tab ini
    local subTabDefs  = opts.SubTabs or {}
    local subTabBtns  = {}
    local SubPages    = {}
    local ActiveSub   = nil

    local Tab = {}

    local function showSubPage(idx)
        if ActiveSub then
            subTabBtns[ActiveSub].TextColor3 = Theme.Unselected
        end
        ActiveSub = idx
        subTabBtns[idx].TextColor3 = Theme.TextColor
        for i, sp in ipairs(SubPages) do
            sp.Visible = (i == idx)
        end
    end

    local function buildSubTabs()
        -- hapus sub-tab lama
        for _, c in ipairs(SubTabBar:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        table.clear(subTabBtns)
        table.clear(SubPages)
        ActiveSub = nil

        if #subTabDefs == 0 then return end

        for i, stLabel in ipairs(subTabDefs) do
            local btn = makeSubTab(stLabel, i)
            subTabBtns[i] = btn

            local sp = Instance.new("Frame")
            sp.Name             = "SubPage_" .. stLabel
            sp.Size             = UDim2.fromScale(1, 1)
            sp.BackgroundTransparency = 1
            sp.Visible          = false
            sp.Parent           = page
            SubPages[i]         = sp

            track(btn.MouseButton1Click:Connect(function()
                showSubPage(i)
            end))
        end
        showSubPage(1)
    end

    local function activateTab()
        -- nonaktifkan semua tab
        for _, tp in ipairs(TabPages) do
            tp.page.Visible = false
            tp.setActive(false)
        end
        page.Visible = true
        railSetActive(true)
        PageTitle.Text = label
        buildSubTabs()
    end

    track(railBtn.MouseButton1Click:Connect(activateTab))

    TabPages[#TabPages + 1] = { page = page, setActive = railSetActive }

    -- aktifkan tab pertama
    if #TabPages == 1 then
        activateTab()
    end

    --  AddSection ke page atau ke SubPage[idx]
    function Tab:AddSection(opts2)
        local side     = opts2.Side or "left"
        local subIdx   = opts2.SubTab  -- opsional: nomor sub-tab

        local targetParent
        if subIdx and SubPages[subIdx] then
            -- buat kolom di dalam subpage
            local colKey = "sub_" .. tostring(subIdx) .. "_" .. side
            if not Columns[colKey] then
                local sp = SubPages[subIdx]
                local spLayout = sp:FindFirstChildOfClass("UIListLayout")
                if not spLayout then
                    spLayout = Instance.new("UIListLayout")
                    spLayout.FillDirection = Enum.FillDirection.Horizontal
                    spLayout.VerticalAlignment = Enum.VerticalAlignment.Top
                    spLayout.Padding = UDim.new(0, SECTION_GAP)
                    spLayout.Parent = sp
                    Instance.new("UIPadding", sp).PaddingAll = UDim.new(0, SECTION_GAP)
                end
                local col = Instance.new("Frame")
                col.BackgroundTransparency = 1
                col.Size = UDim2.new(0.5, -math.floor(SECTION_GAP/2), 0, 0)
                col.AutomaticSize = Enum.AutomaticSize.Y
                col.LayoutOrder = side == "left" and 0 or 1
                col.Parent = sp
                local cl = Instance.new("UIListLayout")
                cl.SortOrder = Enum.SortOrder.LayoutOrder
                cl.Padding = UDim.new(0, SECTION_GAP)
                cl.Parent = col
                Columns[colKey] = col
            end
            targetParent = Columns[colKey]
        else
            -- gunakan kolom global di page utama
            local colKey = "tab_" .. label .. "_" .. side
            if not Columns[colKey] then
                local col = Instance.new("Frame")
                col.BackgroundTransparency = 1
                col.Size = UDim2.new(0.5, -math.floor(SECTION_GAP/2), 0, 0)
                col.AutomaticSize = Enum.AutomaticSize.Y
                col.LayoutOrder = side == "left" and 0 or 1
                col.Parent = page
                local cl = Instance.new("UIListLayout")
                cl.SortOrder = Enum.SortOrder.LayoutOrder
                cl.Padding = UDim.new(0, SECTION_GAP)
                cl.Parent = col
                Columns[colKey] = col

                -- layout horizontal untuk page ini
                if not page:FindFirstChildOfClass("UIListLayout") then
                    local pl = Instance.new("UIListLayout")
                    pl.FillDirection = Enum.FillDirection.Horizontal
                    pl.VerticalAlignment = Enum.VerticalAlignment.Top
                    pl.Padding = UDim.new(0, SECTION_GAP)
                    pl.Parent = page
                    local pp = Instance.new("UIPadding")
                    pp.PaddingAll = UDim.new(0, SECTION_GAP)
                    pp.Parent = page
                end
            end
            targetParent = Columns[colKey]
        end

        return buildSection(targetParent, opts2)
    end

    return Tab
end

