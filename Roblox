    local layout = Instance.new("UIListLayout")
    layout.SortOrder   = Enum.SortOrder.LayoutOrder
    layout.Padding      = UDim.new(0, SECTION_GAP)
    layout.Parent       = col

    Columns[side] = col
    return col
end

--==========================================================================
--  Rail Tab builder
--==========================================================================
local RailTabs      = {}
local ActiveRailTab = nil

local function makeRailTab(label, icon, order)
    local btn = Instance.new("TextButton")
    btn.Name             = "RailTab_" .. label
    btn.Size             = UDim2.fromOffset(44, 44)
    btn.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel  = 0
    btn.Text             = icon or label:sub(1,1)
    btn.TextColor3       = Theme.Unselected
    btn.TextSize         = icon and 18 or 13
    btn.Font             = Enum.Font.GothamBold
    btn.AutoButtonColor  = false
    btn.LayoutOrder      = order or (#RailTabs + 1)
    btn.Parent           = Rail

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent       = btn

    local function setActive(active)
        tween(btn, {
            BackgroundColor3    = active and Theme.TabHighlight or Color3.fromRGB(10,10,10),
            BackgroundTransparency = active and 0 or 1,
            TextColor3          = active and Theme.TextColor or Theme.Unselected,
        }, 0.12)
    end

    RailTabs[#RailTabs + 1] = { Button = btn, SetActive = setActive }
    return btn, setActive
end

