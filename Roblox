            local function onHover(on)
                tween(item, { BackgroundTransparency = on and 0.85 or 1,
                              BackgroundColor3 = Theme.Accent }, 0.08)
            end
            track(item.MouseEnter:Connect(function() onHover(true) end))
            track(item.MouseLeave:Connect(function() onHover(false) end))

            track(item.MouseButton1Click:Connect(function()
                selected = opt
                display.Text = selected .. "  ▾"
                for _, c in ipairs(popup:GetChildren()) do
                    if c:IsA("TextButton") then
                        c.TextColor3 = c.Text == selected and Theme.Accent or Theme.TextColor
                    end
                end
                popup.Visible = false
                open = false
                for _, cb in ipairs(changedCallbacks) do pcall(cb, selected) end
            end))
        end

        local function togglePopup()
            open = not open
            if open then
                local abs = display.AbsolutePosition
                popup.Position = UDim2.fromOffset(abs.X, abs.Y + 20)
                popup.Visible  = true
            else
                popup.Visible = false
            end
        end

        track(display.MouseButton1Click:Connect(togglePopup))

        -- tutup kalau klik di luar
        track(UserInputService.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 and open then
                local mp = UserInputService:GetMouseLocation()
                local pp = popup.AbsolutePosition
                local ps = popup.AbsoluteSize
                if not (mp.X >= pp.X and mp.X <= pp.X + ps.X and mp.Y >= pp.Y and mp.Y <= pp.Y + ps.Y) then
                    popup.Visible = false
                    open = false
                end
            end
        end))

        local ctrl = { Value = selected }
        function ctrl:Set(v)
            selected = v
            display.Text = v .. "  ▾"
        end
        function ctrl:Get() return selected end
        function ctrl:OnChanged(cb) table.insert(changedCallbacks, cb) return self end
        return ctrl
    end

