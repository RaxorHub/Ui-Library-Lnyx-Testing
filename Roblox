    function Section:AddColor(o)
        elementCount += 1
        local row, right = makeRow(sectionFrame, o.Label)
        row.LayoutOrder = elementCount

        local currentColor = o.Default or Color3.fromRGB(197, 59, 59)
        local changedCallbacks = {}

        local swatch = Instance.new("TextButton")
        swatch.Size             = UDim2.fromOffset(14, 14)
        swatch.BackgroundColor3 = currentColor
        swatch.BorderSizePixel  = 0
        swatch.Text             = ""
        swatch.AutoButtonColor  = false
        swatch.LayoutOrder      = 0
        swatch.Parent           = right

        local sCorner = Instance.new("UICorner")
