    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent       = sectionFrame

    local stroke = Instance.new("UIStroke")
    stroke.Color     = Theme.Outline
    stroke.Thickness = 1
    stroke.Parent    = sectionFrame

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent    = sectionFrame

    -- Title bar
    local titleBar = Instance.new("Frame")
    titleBar.Name             = "TitleBar"
    titleBar.Size             = UDim2.new(1, 0, 0, 22)
    titleBar.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
    titleBar.BorderSizePixel  = 0
    titleBar.LayoutOrder      = 0
    titleBar.Parent           = sectionFrame

    local titleCorner = Instance.new("UICorner")
    titleCorner.CornerRadius = UDim.new(0, 5)
    titleCorner.Parent       = titleBar

    -- Accent bar kiri
    local accentBar = Instance.new("Frame")
    accentBar.Size             = UDim2.new(0, 2, 1, 0)
    accentBar.BackgroundColor3 = Theme.Accent
    accentBar.BorderSizePixel  = 0
    accentBar.Parent           = titleBar

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Position         = UDim2.fromOffset(10, 0)
    titleLabel.Size             = UDim2.new(1, -10, 1, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text             = (opts.Title or ""):upper()
    titleLabel.TextColor3       = Color3.fromRGB(120, 120, 120)
    titleLabel.TextSize         = 11
    titleLabel.Font             = Enum.Font.GothamBold
    titleLabel.TextXAlignment   = Enum.TextXAlignment.Left
    titleLabel.LayoutOrder      = 1
    titleLabel.Parent           = titleBar

    local divider = Instance.new("Frame")
    divider.Size             = UDim2.new(1, 0, 0, 1)
    divider.Position         = UDim2.new(0, 0, 1, -1)
    divider.BackgroundColor3 = Theme.Outline
    divider.BorderSizePixel  = 0
    divider.Parent           = titleBar

    local elementCount = 0

    local Section = {}

    -- TOGGLE
    function Section:AddToggle(o)
        elementCount += 1
        local row, right = makeRow(sectionFrame, o.Label)
        row.LayoutOrder = elementCount

        -- Mode label (Always / Toggle / Hold)
        local modes = {"Always", "Toggle", "Hold"}
        local modeIdx = 1
        local modeLabel = Instance.new("TextLabel")
        modeLabel.Size             = UDim2.fromOffset(40, ROW_H)
        modeLabel.BackgroundTransparency = 1
        modeLabel.Text             = modes[modeIdx]
        modeLabel.TextColor3       = (o.Default and Theme.TextColor or Theme.Unselected)
        modeLabel.TextSize         = 11
        modeLabel.Font             = Enum.Font.Gotham
        modeLabel.TextXAlignment   = Enum.TextXAlignment.Right
        modeLabel.LayoutOrder      = 0
        modeLabel.Parent           = right

        -- Toggle background
        local toggleBg = Instance.new("Frame")
        toggleBg.Size             = UDim2.fromOffset(28, 14)
        toggleBg.BackgroundColor3 = o.Default and Theme.ToggleBgOn or Theme.ToggleBgOff
        toggleBg.BorderSizePixel  = 0
        toggleBg.LayoutOrder      = 1
        toggleBg.Parent           = right

        local bgCorner = Instance.new("UICorner")
        bgCorner.CornerRadius = UDim.new(1, 0)
        bgCorner.Parent       = toggleBg

        local bgStroke = Instance.new("UIStroke")
        bgStroke.Color     = Color3.fromRGB(40, 40, 40)
        bgStroke.Thickness = 1
        bgStroke.Parent    = toggleBg

        -- Toggle circle
        local circle = Instance.new("Frame")
        circle.Size             = UDim2.fromOffset(10, 10)
        circle.Position         = o.Default
            and UDim2.fromOffset(15, 2)
            or  UDim2.fromOffset(2, 2)
        circle.BackgroundColor3 = o.Default and Theme.ToggleCircleOn or Theme.ToggleCircleOff
        circle.BorderSizePixel  = 0
        circle.Parent           = toggleBg

        local circleCorner = Instance.new("UICorner")
        circleCorner.CornerRadius = UDim.new(1, 0)
        circleCorner.Parent       = circle

        -- Hit button
        local hit = Instance.new("TextButton")
        hit.Size             = UDim2.fromScale(1, 1)
        hit.Position         = UDim2.new(0, 0, 0, 0)
        hit.BackgroundTransparency = 1
        hit.Text             = ""
        hit.ZIndex           = 5
        hit.Parent           = row

        local value = o.Default or false
        local changedCallbacks = {}

        local function setValue(v, silent)
            value = v
            if v then
                tween(toggleBg, { BackgroundColor3 = Theme.ToggleBgOn }, 0.12)
                tween(circle, { Position = UDim2.fromOffset(15, 2), BackgroundColor3 = Theme.ToggleCircleOn }, 0.12)
                tween(modeLabel, { TextColor3 = Theme.TextColor }, 0.12)
                bgStroke.Color = Theme.Accent
            else
                tween(toggleBg, { BackgroundColor3 = Theme.ToggleBgOff }, 0.12)
                tween(circle, { Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Theme.ToggleCircleOff }, 0.12)
                tween(modeLabel, { TextColor3 = Theme.Unselected }, 0.12)
                bgStroke.Color = Color3.fromRGB(40, 40, 40)
            end
            if not silent then
                for _, cb in ipairs(changedCallbacks) do
                    pcall(cb, value)
                end
            end
        end

        track(hit.MouseButton1Click:Connect(function()
            setValue(not value)
        end))

        -- Right-click untuk ganti mode
        track(hit.MouseButton2Click:Connect(function()
            modeIdx = modeIdx % #modes + 1
            modeLabel.Text = modes[modeIdx]
        end))

        local ctrl = { Value = value }
        function ctrl:Set(v) setValue(v) end
        function ctrl:Get() return value end
        function ctrl:OnChanged(cb) table.insert(changedCallbacks, cb) return self end
        return ctrl
    end

    -- SLIDER
    function Section:AddSlider(o)
        elementCount += 1
        local row, right = makeRow(sectionFrame, o.Label)
        row.LayoutOrder = elementCount

        local min    = o.Min or 0
        local max    = o.Max or 100
        local defVal = math.clamp(o.Default or min, min, max)
        local changedCallbacks = {}

        local valLabel = Instance.new("TextLabel")
        valLabel.Size             = UDim2.fromOffset(30, ROW_H)
        valLabel.BackgroundTransparency = 1
        valLabel.Text             = tostring(defVal)
        valLabel.TextColor3       = Theme.Unselected
        valLabel.TextSize         = 11
        valLabel.Font             = Enum.Font.Gotham
        valLabel.TextXAlignment   = Enum.TextXAlignment.Right
        valLabel.LayoutOrder      = 0
        valLabel.Parent           = right

        -- Track
        local trackFrame = Instance.new("Frame")
        trackFrame.Size             = UDim2.fromOffset(90, 3)
        trackFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        trackFrame.BorderSizePixel  = 0
        trackFrame.LayoutOrder      = 1
        trackFrame.Parent           = right

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent       = trackFrame

        local fill = Instance.new("Frame")
        fill.Size             = UDim2.new((defVal - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = Theme.Accent
        fill.BorderSizePixel  = 0
        fill.Parent           = trackFrame

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent       = fill

        -- Handle
        local handle = Instance.new("Frame")
        handle.Size             = UDim2.fromOffset(10, 10)
        handle.AnchorPoint      = Vector2.new(0.5, 0.5)
        handle.Position         = UDim2.new((defVal - min) / (max - min), 0, 0.5, 0)
        handle.BackgroundColor3 = Theme.TextColor
        handle.BorderSizePixel  = 0
        handle.ZIndex           = 3
        handle.Parent           = trackFrame

        local handleCorner = Instance.new("UICorner")
        handleCorner.CornerRadius = UDim.new(1, 0)
        handleCorner.Parent       = handle

        local hit = Instance.new("TextButton")
        hit.Size             = UDim2.new(1, 0, 0, ROW_H)
        hit.Position         = UDim2.new(0, 0, 0.5, -ROW_H/2)
        hit.BackgroundTransparency = 1
        hit.Text             = ""
        hit.ZIndex           = 5
        hit.Parent           = trackFrame

        local value   = defVal
        local sliding = false

        local function updateValue(v)
            v = math.clamp(math.round(v), min, max)
            if v == value then return end
            value = v
            local pct = (value - min) / (max - min)
            fill.Size     = UDim2.new(pct, 0, 1, 0)
            handle.Position = UDim2.new(pct, 0, 0.5, 0)
            valLabel.Text = tostring(value)
            for _, cb in ipairs(changedCallbacks) do pcall(cb, value) end
        end

        local function getValueFromX(x)
            local abs = trackFrame.AbsolutePosition.X
            local w   = trackFrame.AbsoluteSize.X
            local pct = math.clamp((x - abs) / w, 0, 1)
            return min + pct * (max - min)
        end

        track(hit.MouseButton1Down:Connect(function()
            sliding = true
        end))
        track(UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                sliding = false
            end
        end))
        track(UserInputService.InputChanged:Connect(function(inp)
            if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
                updateValue(getValueFromX(inp.Position.X))
            end
        end))
        track(hit.MouseButton1Click:Connect(function()
            updateValue(getValueFromX(UserInputService:GetMouseLocation().X))
        end))

        local ctrl = { Value = value }
        function ctrl:Set(v) updateValue(v) end
        function ctrl:Get() return value end
        function ctrl:OnChanged(cb) table.insert(changedCallbacks, cb) return self end
        return ctrl
    end

    -- DROPDOWN
    function Section:AddDropdown(o)
        elementCount += 1
        local row, right = makeRow(sectionFrame, o.Label)
        row.LayoutOrder = elementCount

        local options = o.Options or {}
        local selected = o.Default or options[1] or ""
        local changedCallbacks = {}
        local open = false

        -- Display button
        local display = Instance.new("TextButton")
        display.Size             = UDim2.fromOffset(110, 18)
        display.BackgroundColor3 = Color3.fromRGB(13, 13, 13)
