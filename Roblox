--==========================================================================
--  Utilities internas
--==========================================================================
local function tween(obj, props, t, style, dir)
    style = style or Enum.EasingStyle.Quad
    dir   = dir   or Enum.EasingDirection.Out
    return TweenService:Create(obj, TweenInfo.new(t or 0.15, style, dir), props):Play()
end

local function cloneref(obj)
    local fn = (getgenv().cloneref or function(x) return x end)
    local ok, r = pcall(fn, obj)
    return (ok and r) or obj
end

local function getParent()
    local ok, h = pcall(function()
        local gethui = getgenv().gethui
        return gethui and gethui()
    end)
    return (ok and h) or cloneref(CoreGui)
end

